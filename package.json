{
  "name": "modulo",
  "version": "0.1.0",
  "private": true,
  "portless": "modulo",
  "scripts": {
    "dev": "bun run components:sync && bun run registry:build && portless run next dev",
    "build": "bun run components:sync && bun run registry:build && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "bun run components:sync && bun run registry:build && next typegen && tsc --noEmit",
    "media:build": "bun scripts/build-component-media.ts",
    "registry:build": "bun scripts/build-registry.ts",
    "components:sync": "bun scripts/sync-components.ts",
    "verify:access": "bun run registry:build && bun --conditions=react-server scripts/verify-access.ts",
    "mint:passphrase": "bun scripts/mint-passphrase.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@huggingface/transformers": "3.8.1",
    "@libsql/client": "^0.18.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "geist": "^1.9.1",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "three": "0.186.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "portless": "^0.16.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
